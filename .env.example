# Closet Lunna — variaveis de ambiente
#
# Copie este arquivo para `.env` e preencha com os valores reais.
# NUNCA versione o `.env` preenchido.

# ---------------------------------------------------------------------------
# Banco de dados (Neon PostgreSQL)
# ---------------------------------------------------------------------------
# Connection string do Neon, com pooler (host com sufixo `-pooler`).
# Usada em runtime pela aplicacao.
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.us-east-1.aws.neon.tech/closet_lunnar?sslmode=require"

# Conexao direta (sem pooler), usada apenas por migrations do Prisma.
DIRECT_URL="postgresql://usuario:senha@ep-xxxx.us-east-1.aws.neon.tech/closet_lunnar?sslmode=require"

# ---------------------------------------------------------------------------
# Sessao do painel e da area da cliente
# ---------------------------------------------------------------------------
# Gere com: openssl rand -base64 32
# Nao use valor de exemplo em producao.
SESSION_SECRET="troque-por-uma-chave-aleatoria-de-32-bytes"

# ---------------------------------------------------------------------------
# Integracoes (preencher conforme cada modulo for ativado)
# ---------------------------------------------------------------------------
# InfinitePay (Checkout Integrado) — so a InfiniteTag, sem chave. Editavel no admin.
INFINITEPAY_HANDLE="sua-infinitetag"

# Conta admin criada pelo seed (node prisma/seed.mjs)
ADMIN_EMAIL="admin@sualoja.com.br"
ADMIN_PASSWORD="troque-por-uma-senha-forte"

# Avisos opcionais de pedido pago
RESEND_API_KEY=""
AVISO_EMAIL_REMETENTE=""
AVISO_EMAIL_LOJA=""
AVISO_WEBHOOK_URL=""

# Fotos de produto (Vercel Blob — criado automaticamente ao ligar o store ao projeto)
BLOB_READ_WRITE_TOKEN=""

# Melhor Envio (calculo de frete e etiquetas)
# Token gerado no painel do Melhor Envio (Integracoes > Permissoes de acesso).
# Preferivel colar no admin (Configuracoes > Melhor Envio); a variavel e so fallback.
MELHOR_ENVIO_TOKEN=""
MELHOR_ENVIO_CEP_ORIGEM=""
MELHOR_ENVIO_SANDBOX="false"

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# E-mail transacional
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ---------------------------------------------------------------------------
# Endereco publico da aplicacao
# ---------------------------------------------------------------------------
# Em producao na Vercel: https://closetlunna.com.br
NEXT_PUBLIC_APP_URL="http://localhost:3000"
