# Closet Lunna — variaveis de ambiente
#
# Copie este arquivo para `.env` e preencha com os valores reais.
# NUNCA versione o `.env` preenchido.

# ---------------------------------------------------------------------------
# Banco de dados (Neon PostgreSQL)
# ---------------------------------------------------------------------------
# Connection string do Neon, com pooler (host com sufixo `-pooler`).
# Usada em runtime pela aplicacao.
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.us-east-1.aws.neon.tech/closet_lunnar?sslmode=require"

# Conexao direta (sem pooler), usada apenas por migrations do Prisma.
DIRECT_URL="postgresql://usuario:senha@ep-xxxx.us-east-1.aws.neon.tech/closet_lunnar?sslmode=require"

# ---------------------------------------------------------------------------
# Sessao do painel e da area da cliente
# ---------------------------------------------------------------------------
# Gere com: openssl rand -base64 32
# Nao use valor de exemplo em producao.
SESSION_SECRET="troque-por-uma-chave-aleatoria-de-32-bytes"

# ---------------------------------------------------------------------------
# Integracoes (preencher conforme cada modulo for ativado)
# ---------------------------------------------------------------------------
# Mercado Pago / InfinitePay
PAYMENT_PROVIDER=""
PAYMENT_PUBLIC_KEY=""
PAYMENT_SECRET_KEY=""

# Melhor Envio (calculo de frete e etiquetas)
MELHOR_ENVIO_CLIENT_ID=""
MELHOR_ENVIO_CLIENT_SECRET=""
MELHOR_ENVIO_REDIRECT_URI=""
MELHOR_ENVIO_SANDBOX="true"

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# E-mail transacional
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ---------------------------------------------------------------------------
# Endereco publico da aplicacao
# ---------------------------------------------------------------------------
# Em producao na Vercel: https://closetlunna.com.br
NEXT_PUBLIC_APP_URL="http://localhost:3000"
